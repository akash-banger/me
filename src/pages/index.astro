---
import '../styles/tokens.css';
import '../styles/system.css';

const description =
  'Akash Banger builds with AI coding agents daily: apps, pipelines, and Claude Code and Codex workflows that make developers faster. Now starting to build in the open.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Akash Banger</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Akash Banger" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@akash__banger" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const system = matchMedia('(prefers-color-scheme: light)');
        const apply = (t) => document.documentElement.setAttribute('data-theme', t);
        apply(stored ?? (system.matches ? 'light' : 'dark'));
        system.addEventListener('change', (e) => {
          if (!localStorage.getItem('theme')) apply(e.matches ? 'light' : 'dark');
        });
      })();
    </script>
  </head>
  <body>
    <div class="topbar">
      <a class="who" href="/">Akash Banger</a>
      <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
        <svg class="icon-sun" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>
    </div>

    <div class="wrap">
      <div class="hero">
        <div class="hero-cluster">
          <div class="pw p1"><img class="hero-photo" src="/images/portrait.jpg" alt="Akash Banger" width="150" height="150" /></div>
          <div class="pw p2"><img class="hero-photo" src="/images/travel.jpg" alt="Akash on a solo trip in Europe" width="130" height="170" /></div>
          <div class="pw p3"><img class="hero-photo" src="/images/desk.jpg" alt="Akash at his desk, building" width="180" height="130" /></div>
        </div>
        <div>
          <div class="hello">Hey, I'm <b>Akash</b>.</div>
          <div class="statement">
            Obsessed with what one builder can ship in the AI era<span class="dim">.</span> Now
            <u>starting to build in the open</u><span class="dim">,</span>
            <span class="acc">learnings included</span><span class="dim">.</span>
          </div>
          <p class="bio">
            Graduated from IIT Bombay, spent a year as founding engineer at a YC-backed startup,
            and did a stack of internships before that. These days I build with coding agents daily: apps, pipelines,
            Claude Code and Codex workflows, plugins that make developers faster. This site is where
            that starts going public, both what I'm building and what actually works.
          </p>
        </div>
      </div>
    </div>

    <footer>
      <a class="meta flink" href="mailto:akashbanger2@gmail.com">
        <svg width="16" height="12" viewBox="0 0 512 384" aria-hidden="true">
          <path fill="#4285f4" d="M34.91 383.93h81.454V186.123L0 98.844v250.18c0 19.287 15.622 34.906 34.91 34.906"/>
          <path fill="#34a853" d="M395.636 383.93h81.455c19.287 0 34.909-15.62 34.909-34.906V98.844l-116.364 87.279"/>
          <path fill="#fbbc04" d="M395.636 64.03v122.093L512 98.844V81.485c0-43.128-49.229-67.7-83.782-41.89"/>
          <path fill="#ea4335" d="M116.364 186.123V64.03L256 168.755 395.636 64.03v122.093L256 290.85"/>
          <path fill="#c5221f" d="M0 81.485v17.359l116.364 87.279V64.03L83.782 39.596C49.229 13.786 0 38.357 0 81.485"/>
        </svg>
        akashbanger2@gmail.com
      </a>
      <span class="meta social">
        <a class="flink" href="https://x.com/akash__banger" target="_blank" rel="me noopener" aria-label="X">
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          X
        </a>
        <a class="flink" href="https://www.linkedin.com/in/akash-banger/" target="_blank" rel="me noopener" aria-label="LinkedIn">
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#0a66c2" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
          </svg>
          LinkedIn
        </a>
        <a class="flink" href="https://www.instagram.com/akash.banger/" target="_blank" rel="me noopener" aria-label="Instagram">
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
            <defs>
              <linearGradient id="ig-grad" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0" stop-color="#feda75"/>
                <stop offset=".3" stop-color="#fa7e1e"/>
                <stop offset=".55" stop-color="#d62976"/>
                <stop offset=".8" stop-color="#962fbf"/>
                <stop offset="1" stop-color="#4f5bd5"/>
              </linearGradient>
            </defs>
            <path fill="url(#ig-grad)" d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/>
          </svg>
          Instagram
        </a>
        <a class="flink" href="https://github.com/akash-banger" target="_blank" rel="me noopener" aria-label="GitHub">
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.5 11.5 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.604-.015 2.898-.015 3.293 0 .322.216.696.825.578C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          GitHub
        </a>
      </span>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle')!;
      btn.addEventListener('click', () => {
        const next =
          document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>

<style is:global>
  a {
    color: inherit;
  }
  a:not([class]):hover {
    color: var(--primary);
  }

  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    transition: background var(--dur-med) ease;
  }
  .topbar .who {
    text-decoration: none;
  }
  .theme-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-btn);
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      background var(--dur-fast) ease,
      transform var(--dur-fast) var(--ease-out);
  }
  .theme-btn:hover {
    background: var(--chip-bg);
    color: var(--fg);
  }
  .theme-btn:active {
    transform: scale(0.94);
    transition-duration: var(--dur-press);
  }
  .theme-btn svg {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    margin: -8px 0 0 -8px;
    transition:
      opacity 0.25s ease,
      transform 0.25s var(--ease-out),
      filter 0.25s ease;
  }
  html[data-theme='light'] .icon-sun,
  html:not([data-theme='light']) .icon-moon {
    opacity: 0;
    transform: scale(0.9);
    filter: blur(4px);
  }

  .wrap {
    max-width: none;
    width: 80%;
    padding-left: 0;
    padding-right: 0;
    flex: 1;
  }

  .statement {
    max-width: 60%;
  }
  @media (max-width: 680px) {
    .statement {
      max-width: 100%;
    }
  }

  .hero {
    margin-bottom: var(--sp-section);
  }
  .hero-cluster {
    position: relative;
    width: 420px;
    max-width: 100%;
    height: 220px;
    margin-bottom: var(--space-5);
  }
  .bio {
    color: var(--muted);
    font-size: var(--text-body-sm);
    max-width: 80%;
  }

  /* page entrance: topbar drops, hero text drifts up after the photos,
     footer fades last */
  @keyframes drop-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes drift-in {
    from {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .topbar {
    animation: drop-in 0.5s var(--ease-out) both;
  }
  .hello,
  .statement,
  .bio {
    animation: drift-in 0.6s var(--ease-out) both;
  }
  .hello { animation-delay: 0.35s; }
  .statement { animation-delay: 0.5s; }
  .bio { animation-delay: 0.65s; }
  footer {
    animation: fade-in 0.6s ease both;
    animation-delay: 0.9s;
  }

  .pw {
    position: absolute;
    opacity: 0;
    animation:
      photo-in var(--dur-reveal) var(--ease-out) both,
      photo-float 6s ease-in-out infinite;
  }
  @keyframes photo-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes photo-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-card);
    border: 1px solid var(--border);
    background: var(--surface);
    display: block;
    transform: rotate(var(--tilt));
    transition:
      transform 0.32s var(--ease-out),
      box-shadow 0.32s var(--ease-out);
  }
  .pw.p1 {
    --tilt: 3deg;
    width: 150px;
    height: 150px;
    left: 110px;
    top: 8px;
    z-index: 3;
    animation-delay: 0s, 0.5s;
  }
  .pw.p2 {
    --tilt: -6deg;
    width: 130px;
    height: 170px;
    left: 0;
    top: 24px;
    z-index: 2;
    animation-delay: var(--stagger), 1.6s;
    animation-duration: var(--dur-reveal), 7s;
  }
  .pw.p3 {
    --tilt: 5deg;
    width: 180px;
    height: 130px;
    left: 235px;
    top: 40px;
    z-index: 1;
    animation-delay: calc(var(--stagger) * 2), 2.7s;
    animation-duration: var(--dur-reveal), 6.5s;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-cluster:has(.hero-photo:hover) .pw {
      animation-play-state: paused, paused;
    }
    .pw:hover {
      z-index: 4;
    }
    .pw:hover .hero-photo {
      transform: rotate(0deg) scale(1.12);
      box-shadow: var(--hover-shadow);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pw {
      animation: none;
      opacity: 1;
    }
  }

  footer {
    width: 80%;
    margin: 0 auto;
    border-top: 1px solid var(--border);
    padding: 20px 0 40px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  footer a {
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }
  footer a:hover {
    color: var(--primary);
  }
  .flink {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .flink svg {
    flex-shrink: 0;
  }
  .social {
    display: inline-flex;
    align-items: center;
    gap: 18px;
  }
</style>
